# 复制本文件为 .env 并填入你的 API Key（.env 已被 .gitignore 忽略，不会提交到仓库）
# 用法：python -m src.summarize.summarize --method llm

# API Key（必填）：Moonshot/Kimi、DeepSeek、OpenAI 或其他兼容服务的 Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# OpenAI 兼容服务地址（按你使用的服务修改）：
#   OpenAI 官方:    https://api.openai.com/v1
#   Moonshot/Kimi:  https://api.moonshot.cn/v1
#   DeepSeek:       https://api.deepseek.com/v1
#   硅基流动:       https://api.siliconflow.cn/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称（按服务可选模型修改，如 moonshot-v1-8k、deepseek-chat、Qwen/Qwen2.5-7B-Instruct 等）
LLM_MODEL=gpt-4o-mini
